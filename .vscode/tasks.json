{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Собрать .app",
      "type": "shell",
      "command": "./build_app.sh",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$swiftc",
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "Собрать и запустить",
      "type": "shell",
      "command": "./build_app.sh --run",
      "problemMatcher": "$swiftc",
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "Собрать универсальный .app (Apple Silicon + Intel)",
      "type": "shell",
      "command": "./build_app.sh --universal",
      "problemMatcher": "$swiftc",
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "Только проверить компиляцию (swift build)",
      "type": "shell",
      "command": "swift build",
      "problemMatcher": "$swiftc",
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "Остановить Snowfall",
      "type": "shell",
      "command": "pkill -x SnowfallMac || true",
      "problemMatcher": []
    }
  ]
}
